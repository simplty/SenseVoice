# SenseVoice ASR Configuration
SENSEVOICE_DEVICE=cpu

# LLM Post-processing Configuration (Optional)
# Set LLM_ENABLED=true to enable LLM post-processing
# Set LLM_ENABLED=false to disable LLM post-processing

LLM_ENABLED=false
LLM_API_KEY=sk-GHm8oViPIGTrja3Jx4PcvnwOBPklFLpljFt8BrOuhoZlNNhJ
# LLM_MODEL=Phi-4
# LLM_BASE_URL=https://comfyrouter.com/v1
LLM_MODEL=phi3
LLM_BASE_URL=http://localhost:7863
LLM_TIMEOUT=3.0

# LLM Prompts (use {text} as placeholder for ASR result)
LLM_SYSTEM_PROMPT="你是一个专业的语音识别结果校对助手。你的任务是纠正语音识别结果中的错误，包括但不限于：标点符号、专业术语、语法问题、同音异义词等。请保持原意不变，只进行必要的纠正。特别注意以下常见的ASR误识别：'Cloud Code' 应该纠正为 'Claude Code'，'克劳德代码' 应该纠正为 'Claude Code'，'克劳丁代码' 应该纠正为 'Claude Code'。"
LLM_USER_PROMPT="请纠正以下语音识别结果中的错误，只返回纠正后的文本，不要添加任何解释或说明。特别注意：如果文本中出现 'Cloud Code'、'克劳德代码'、'克劳丁代码' 等词汇，应该纠正为 'Claude Code'：\n\n{text}"